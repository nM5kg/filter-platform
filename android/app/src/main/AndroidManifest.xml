<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.filterplatform.app">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- GeckoView 160 (org.mozilla.geckoview AAR manifest) requires these two;
         Gradle's manifest merger adds them automatically — they are listed
         here explicitly so the manual build (which has no merger) matches. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <!-- GeckoView requires OpenGL ES 2.0 (from its AAR manifest). -->
    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />
    <uses-feature
        android:glEsVersion="0x00020000"
        android:required="true" />

    <application
        android:allowBackup="false"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.Light.DarkActionBar"
        android:usesCleartextTraffic="false">
        <!-- NOTE (0.1.1 fix): the GeckoView AAR manifest's zygotePreloadName
             (org.mozilla.gecko.process.ZygotePreload) was in 0.1.0 and the
             app died at process start on the user's BLU phone with only
             "keeps stopping" — the preload runs before any Activity and
             can kill the process if it fails. GeckoView works without it
             (it is only a startup optimisation), so it is REMOVED here. -->
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- GeckoView browser prototype (own UI + own filter engine).
             The GeckoView services / content provider from the
             org.mozilla.geckoview AAR manifest are merged in by Gradle's
             manifest merger on a normal build; the manual build reproduces
             that with manual-build/merge_manifest.py. -->
        <activity
            android:name=".BrowserActivity"
            android:exported="false"
            android:label="Filter Browser" />
    </application>

</manifest>
