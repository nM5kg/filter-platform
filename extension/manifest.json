{
  "action": {
    "default_popup": "popup.html",
    "default_title": "Filter Platform"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "all_frames": false,
      "js": [
        "vendor/face-api.js",
        "content.js"
      ],
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "run_at": "document_idle"
    }
  ],
  "description": "Free kosher internet filter: blocks human pictures per policy (on-device face detection) and blocks listed domains. Phase 2.",
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "manifest_version": 3,
  "name": "Filter Platform \u2014 Kosher Browser Filter",
  "permissions": [
    "storage",
    "declarativeNetRequest",
    "alarms"
  ],
  "short_name": "Filter Platform",
  "version": "1.0.0",
  "web_accessible_resources": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "resources": [
        "models/*"
      ]
    }
  ]
}